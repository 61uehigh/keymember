# Where data is kept: "sql" (PostgreSQL or embedded PGlite) or "firestore".
KEYMEMBER_STORE=sql
# sql: PostgreSQL connection URL. Leave empty to use KEYMEMBER_PGLITE_DIR instead.
DATABASE_URL=
# sql: directory for an embedded PGlite database, enough for a team-sized server.
KEYMEMBER_PGLITE_DIR=
# firestore: database id when not "(default)". The project comes from the environment.
KEYMEMBER_FIRESTORE_DATABASE=
# Required. At least 32 random bytes in base64url:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
KEYMEMBER_SERVER_SECRET=
# Behind a reverse proxy: the number of proxies to trust in X-Forwarded-For (1 for Cloud Run or
# Caddy). Leave empty when clients connect directly.
KEYMEMBER_TRUST_PROXY=
HOST=127.0.0.1
PORT=8080
# Directory of the built web app (apps/web/dist); leave empty to serve the API only.
KEYMEMBER_WEB_DIR=
# Token needed to create the organisation. When empty, a random one is printed in the log until
# the organisation exists.
KEYMEMBER_BOOTSTRAP_TOKEN=
