# Domain keymember is served on, e.g. vault.example.com. Its DNS must point at this machine.
KEYMEMBER_DOMAIN=
# Required. At least 32 random bytes in base64url, kept stable across restarts:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
KEYMEMBER_SERVER_SECRET=
# Optional: token needed to create the organisation. When empty, the server prints a random one
# in its log until the organisation exists.
KEYMEMBER_BOOTSTRAP_TOKEN=
# Optional: company-account sign-in (Google Workspace). Set the first four together, or none.
# The public URL is https:// plus KEYMEMBER_DOMAIN.
KEYMEMBER_PUBLIC_URL=
KEYMEMBER_OIDC_ISSUER=
KEYMEMBER_OIDC_CLIENT_ID=
KEYMEMBER_OIDC_CLIENT_SECRET=
KEYMEMBER_OIDC_HOSTED_DOMAIN=
# Optional: an existing PostgreSQL instead of the built-in PGlite. Takes precedence when set.
DATABASE_URL=
